# Control plane
DEVICE_CONTROL_ENV=local
DEVICE_CONTROL_DB=./var/device-control.sqlite3
DEVICE_CONTROL_ADMIN_TOKEN=replace-with-a-high-entropy-local-provisioning-secret
MINDOS_IDENTITY_HMAC_KEY=replace-with-at-least-32-bytes
MINDOS_IDENTITY_ISSUER=mindos-local
DEVICE_CONTROL_IDENTITY_AUDIENCE=

# Limits and lifetimes (seconds)
DEVICE_CONTROL_APPROVAL_TTL_SECONDS=300
DEVICE_CONTROL_ENROLLMENT_TTL_SECONDS=300
DEVICE_CONTROL_GATEWAY_CREDENTIAL_TTL_SECONDS=86400
DEVICE_CONTROL_ENDPOINT_CREDENTIAL_TTL_SECONDS=2592000
DEVICE_CONTROL_COMMAND_MAX_TTL_SECONDS=3600
DEVICE_CONTROL_STALE_AFTER_SECONDS=90
DEVICE_CONTROL_MAX_REQUEST_BYTES=262144
DEVICE_CONTROL_RATE_LIMIT_PER_MINUTE=240
DEVICE_CONTROL_EVENT_RETENTION_SECONDS=604800
DEVICE_CONTROL_EVIDENCE_DIR=./var/evidence
DEVICE_CONTROL_EVIDENCE_MAX_BYTES=8388608
DEVICE_CONTROL_EVIDENCE_RETENTION_SECONDS=604800
DEVICE_CONTROL_REQUIRE_HTTPS=false
DEVICE_CONTROL_MANIFEST_HMAC_KEY=
