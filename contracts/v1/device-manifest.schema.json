{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-platform.local/contracts/device/device-manifest.v1.schema.json",
  "title": "Device Gateway Capability Manifest",
  "description": "Trusted, versioned capability authority. Risk, operation, state and verification semantics come from this manifest, never from a command envelope or endpoint self-report.",
  "type": "object",
  "required": ["manifest_id", "manifest_version", "protocol_version", "capabilities"],
  "properties": {
    "manifest_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "manifest_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "protocol_version": {"const": "v1"},
    "endpoint_id": {"type": ["string", "null"], "maxLength": 200},
    "device_id": {"type": ["string", "null"], "maxLength": 200},
    "device_fingerprint": {"type": ["string", "null"], "maxLength": 200},
    "signature": {"type": ["string", "null"], "maxLength": 256},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "id", "version", "operation", "risk_tier", "input_schema", "output_schema",
          "requires_state", "verification"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 200},
          "version": {"type": "string", "minLength": 1, "maxLength": 100},
          "operation": {"type": "string", "minLength": 1, "maxLength": 100},
          "risk_tier": {"enum": ["read", "write", "destructive", "safety_critical"]},
          "input_schema": {"type": "object"},
          "output_schema": {"type": "object"},
          "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 120000},
          "supports_idempotency": {"type": "boolean"},
          "requires_state": {"type": "boolean"},
          "allowlist": {"type": "boolean"},
          "state_max_age_ms": {"type": "integer", "minimum": 100, "maximum": 60000},
          "preconditions": {"type": "object"},
          "postconditions": {"type": "object"},
          "verification": {
            "type": "object",
            "required": ["type", "require_change"],
            "properties": {
              "type": {
                "enum": ["ui_state", "ui_change", "field_state", "artifact", "adapter_ack", "manual"]
              },
              "require_change": {"type": "boolean"},
              "predicate": {"type": ["string", "null"], "maxLength": 500}
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "properties": {
              "capture": {"enum": ["none", "screenshot", "node_summary"]},
              "redaction": {"enum": ["required", "none"]},
              "retention_seconds": {"type": "integer", "minimum": 60}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
